// ==============================================================================
// Prisma Schema: Production Diamond Platform (Inventory + Marketplace)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Stone {
  id                  String    @id @default(uuid()) @db.VarChar(64)
  supplierId          Int?      @default(101) @map("supplier_id")
  stockId             String    @unique @map("stock_id") @db.VarChar(64)
  lotId               String?   @map("lot_id") @db.VarChar(64)

  // Status & Lifecycle
  status              String    @default("AVAILABLE") @db.VarChar(32) // AVAILABLE, MEMO, HOLD, SOLD, TRANSIT
  subStatus           String?   @map("sub_status") @db.VarChar(64)
  statusDistribution  Json?     @map("status_distribution")
  type                String?   @default("SINGLE") @db.VarChar(32) // SINGLE, PARCEL, ROUGH, LAYOUT
  diamondType         String    @default("LAB_GROWN") @map("diamond_type") @db.VarChar(32) // LAB_GROWN, NATURAL
  growthType          String?   @default("CVD") @map("growth_type") @db.VarChar(32) // CVD, HPHT, NATURAL

  // 4Cs & Visual Grading
  shape               String    @db.VarChar(32)
  weight              Decimal   @db.Decimal(8, 3)
  color               String?   @db.VarChar(16)
  clarity             String?   @db.VarChar(16)
  cut                 String?   @db.VarChar(16)
  polish              String?   @default("EX") @db.VarChar(16)
  symmetry            String?   @default("EX") @db.VarChar(16)

  // Fluorescence & Color Specifics
  fluorescenceIntensity String? @default("None") @map("fluorescence_intensity") @db.VarChar(32)
  fluorescenceColor   String?   @map("fluorescence_color") @db.VarChar(32)
  fancyColor          String?   @map("fancy_color") @db.VarChar(64)
  fancyColorIntensity String?   @map("fancy_color_intensity") @db.VarChar(32)
  fancyColorOvertone  String?   @map("fancy_color_overtone") @db.VarChar(32)
  isFancyColor        Boolean?  @default(false) @map("is_fancy_color")
  isLabGrown          Boolean?  @default(true) @map("is_lab_grown")

  // Pricing & Commercials
  rate                Decimal   @db.Decimal(12, 2) // $/ct
  finalPrice          Decimal   @map("final_price") @db.Decimal(14, 2)
  discount            Decimal?  @db.Decimal(6, 2)
  costRate            Decimal?  @map("cost_rate") @db.Decimal(12, 2)
  costPrice           Decimal?  @map("cost_price") @db.Decimal(14, 2)

  // Grading Lab & Certificate
  lab                 String    @default("IGI") @db.VarChar(32)
  certificateNumber   String?   @map("certificate_number") @db.VarChar(64)
  certificateComment  String?   @map("certificate_comment") @db.Text
  certificateImage    String?   @map("certificate_image") @db.Text
  laserInscription    String?   @map("laser_inscription") @db.VarChar(64)

  // Physical Measurements & Proportions
  measurements        String?   @db.VarChar(64)
  measurementLength   Decimal?  @map("measurement_length") @db.Decimal(8, 2)
  measurementWidth    Decimal?  @map("measurement_width") @db.Decimal(8, 2)
  measurementDepth    Decimal?  @map("measurement_depth") @db.Decimal(8, 2)
  lwRatio             Decimal?  @map("lw_ratio") @db.Decimal(6, 2)
  tablePct            Decimal?  @map("table_pct") @db.Decimal(6, 2)
  depthPct            Decimal?  @map("depth_pct") @db.Decimal(6, 2)
  crownAngle          Decimal?  @map("crown_angle") @db.Decimal(6, 2)
  crownHeight         Decimal?  @map("crown_height") @db.Decimal(6, 2)
  pavilionAngle       Decimal?  @map("pavilion_angle") @db.Decimal(6, 2)
  pavilionDepth       Decimal?  @map("pavilion_depth") @db.Decimal(6, 2)
  girdlePer           Decimal?  @map("girdle_per") @db.Decimal(6, 2)
  girdleCondition     String?   @map("girdle_condition") @db.VarChar(32)
  girdleThick         String?   @map("girdle_thick") @db.VarChar(32)
  girdleThin          String?   @map("girdle_thin") @db.VarChar(32)
  culetSize           String?   @map("culet_size") @db.VarChar(32)
  culetCondition      String?   @map("culet_condition") @db.VarChar(32)
  starLength          Decimal?  @map("star_length") @db.Decimal(6, 2)

  // Inclusions & Visual Traits
  eyeClean            String?   @default("YES") @map("eye_clean") @db.VarChar(16)
  bgm                 String?   @default("NO") @db.VarChar(16)
  tinge               String?   @db.VarChar(32)
  milky               String?   @default("NO") @db.VarChar(16)
  blackInclusion      String?   @default("NO") @map("black_inclusion") @db.VarChar(16)
  heartAndArrow       String?   @map("heart_and_arrow") @db.VarChar(16)
  keyToSymbols        String?   @map("key_to_symbols") @db.Text
  treatment           String?   @db.VarChar(64)

  // Media
  diamondVideo        String?   @map("diamond_video") @db.Text
  diamondImages       Json?     @default("[]") @map("diamond_images")

  // Custody & Location
  godownId            String?   @map("godown_id") @db.VarChar(64)
  holdingPartyId      String?   @map("holding_party_id") @db.VarChar(64)
  city                String?   @default("SURAT") @db.VarChar(64)
  state               String?   @db.VarChar(64)
  country             String?   @default("INDIA") @db.VarChar(64)
  countryOfOrigin     String?   @map("country_of_origin") @db.VarChar(64)
  countryOfPolishing  String?   @map("country_of_polishing") @db.VarChar(64)
  metalType           String?   @map("metal_type") @db.VarChar(64)
  category            String?   @db.VarChar(64)

  // Audit
  memberComment       String?   @map("member_comment") @db.Text
  isFeatured          Boolean?  @default(false) @map("is_featured")
  isActive            Boolean?  @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  @@map("stones")
  @@index([stockId])
  @@index([certificateNumber])
  @@index([shape])
  @@index([weight])
  @@index([color])
  @@index([clarity])
  @@index([cut])
  @@index([rate])
  @@index([finalPrice])
  @@index([status])
  @@index([diamondType])
  @@index([growthType])
  @@index([isFeatured])
}
